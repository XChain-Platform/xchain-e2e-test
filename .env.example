# XChain E2E Test Suite environment variables.
# Copy to .env and fill in values for your stack.
# NOTE: use INDEXER_URL (not INDEXER_HOST; the old name is stale).

COIN=bitcoin
NETWORK=regtest

NODE_URL=127.0.0.1
NODE_PORT=8332
NODE_USER=xchain
NODE_PASSWORD=xchain-password

DATABASE_URL=127.0.0.1
DATABASE_PORT=3306

# Service API ports below are an intentionally ISOLATED set for the e2e harness
# (collision avoidance when co-located with other stacks on one host); they
# deliberately differ from the canonical installer port map and are not drift.
UTXO_TRACKER_URL=127.0.0.1
UTXO_TRACKER_API_PORT=3001

ENCODER_URL=127.0.0.1
ENCODER_API_PORT=3003

DECODER_URL=127.0.0.1
DECODER_API_PORT=3007

INDEXER_URL=127.0.0.1
INDEXER_API_PORT=3009

EXPLORER_URL=127.0.0.1
EXPLORER_API_PORT=3005

INDEXER_DB_NAME=XChain_BTC_Regtest_Indexer
INDEXER_DB_USER=xchain_indexer_bitcoin_regtest
INDEXER_DB_PASS=xchain-password

REGTEST_MINER_URL=127.0.0.1
REGTEST_MINER_API_PORT=3011

HUB_URL=127.0.0.1
HUB_PORT=3013

# Hub database reach (test/helpers/hubMirrorTopology.js documents the whole contract).
# HUB_DB_HOST + HUB_DB_NAME must equal what the INDEXER was started with: that is where
# its price lookups READ. On the ordinary regtest stack the indexer's hub database is its
# OWN database (hub_db_sync lands the mirror tables there). Leave HUB_DB_NAME unset when
# the indexer has no hub DB at all; the suite asks the indexer at bootstrap either way.
HUB_DB_HOST=127.0.0.1
HUB_DB_PORT=13306
HUB_DB_USER=xchain_hub
HUB_DB_PASS=xchain-password
HUB_DB_NAME=XChain_BTC_Regtest_Indexer
# The hub's OWN authoritative database. Set it when hub_db_sync mirrors price tables
# down to the indexer: the fee helper then seeds oracle prices there as well, so a
# replay after an indexer reset (which re-pages the mirror from the hub) keeps them.
# Host/port/user/pass default to the HUB_DB_* values above (HUB_SOURCE_DB_HOST/PORT/
# USER/PASS override them when the hub runs its own MariaDB).
HUB_SOURCE_DB_NAME=XChain_Hub
