{
  "name": "xchain-e2e-test",
  "description": "xchain-e2e-test is an end-to-end testing suite for the XChain platform to ensure data integrity",
  "version": "0.3.8",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-e2e-test.git"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bip32": "4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "6.1.7",
    "dotenv": "^16.4.5",
    "ecpair": "2.1.0",
    "mariadb": "3.5.2",
    "tiny-secp256k1": "2.2.4",
    "xchain-hub": "file:./xchain-hub",
    "xchain-sdk": "file:./xchain-sdk"
  },
  "scripts": {
    "ci": "mocha --no-config --timeout 30000 --exit 'test/unit/coins-conformance.test.js' 'test/unit/security/configuration/dependency-advisories.test.js' 'test/unit/security/configuration/sibling-tree-advisories.test.js' 'test/integration/parity/**/*.test.js' 'test/integration/multiHubActivationBoundary.integration.test.js'",
    "test": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/actions/**/*.test.js'",
    "test:contracts": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/contracts/**/*.test.js'",
    "test:auctions": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/contracts/englishAuction.test.js test/contracts/dutchAuction.test.js",
    "test:codec": "mocha --no-config --timeout 30000 --exit 'test/codec/**/*.test.js'",
    "test:sdk": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/sdk/**/*.sdk.test.js'",
    "test:sdk:chunked": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/chunkedDeploy.sdk.test.js",
    "test:sdk:chunked-reorg": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/chunkedDeployReorgDrill.sdk.test.js",
    "test:sdk:vote": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/sdk/vote.sdk.test.js' 'test/sdk/voteAdvanced.sdk.test.js' 'test/sdk/voteBinding.sdk.test.js' 'test/sdk/voteDeposit.sdk.test.js' 'test/sdk/voteFinalize.sdk.test.js' 'test/sdk/votePollResult.sdk.test.js'",
    "test:sdk:vote-reorg": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/voteReorgDrill.sdk.test.js",
    "test:sdk:dex-reorg": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/dexSourceReorgDrill.sdk.test.js",
    "test:sdk:bet": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/bet.sdk.test.js test/sdk/betNegative.sdk.test.js test/sdk/betTerminal.sdk.test.js test/sdk/betGas.sdk.test.js test/sdk/betGating.sdk.test.js test/sdk/betInteractions.sdk.test.js",
    "test:sdk:bet-reorg": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/betReorgDrill.sdk.test.js",
    "test:sdk:xcall-reorg": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/xcallSourceReorgDrill.sdk.test.js",
    "test:sdk:x402": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/x402.sdk.test.js",
    "test:sdk:mcp": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/mcp.sdk.test.js",
    "test:sdk:tickerid": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/ticker-id-equivalence.sdk.test.js",
    "test:sdk:decoder": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/decoderRoundtrip.sdk.test.js",
    "test:compaction": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/actions/compactionFixLive.test.js",
    "test:federation": "E2E_REQUIRE_FEDERATION=1 mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/federation/multiHubAttestation.test.js'",
    "test:federation:nodeproof": "E2E_REQUIRE_FEDERATION=1 mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/federation/multiHubNodeProof.test.js'",
    "test:attestation:llm": "E2E_REQUIRE_FEDERATION=1 mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/federation/llmAttestation.test.js'",
    "test:federation:llm:multi": "E2E_REQUIRE_FEDERATION=1 mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/federation/multiHubLlmAttestation.test.js'",
    "test:federation:dex": "mocha --timeout 180000 --exit 'test/integration/multiHubCrossChainDex.integration.test.js'",
    "test:vm": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/actions/vm*.test.js' test/actions/contractStaking.test.js 'test/security/vm*.test.js'",
    "test:security": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/security/**/*.test.js'",
    "test:smoke": "mocha --bail --timeout 30000 --exit --require ./test/initialCheck.test.js 'test/smoke/**/*.smoke.js'",
    "test:unit": "mocha 'test/unit/**/*.test.js'",
    "test:integration": "npm run test:integration:stubbed && npm run test:integration:live",
    "test:integration:stubbed": "mocha --timeout 0 --exit 'test/integration/*/**/*.test.js'",
    "test:integration:live": "mocha --timeout 0 --exit 'test/integration/*.integration.test.js'",
    "test:e2e": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js 'test/e2e/**/*.e2e.js'",
    "test:boundary": "mocha 'test/boundary/**/*.boundary.js'",
    "test:fuzz": "mocha --timeout 60000 'test/fuzz/**/*.fuzz.js'",
    "test:fuzz:quick": "mocha --timeout 30000 'test/fuzz/**/*.fuzz.js'",
    "test:chaos": "mocha --timeout 10000 'test/chaos/**/*.chaos.js'",
    "test:chaos:quick": "mocha --timeout 10000 --grep '@P0' 'test/chaos/**/*.chaos.js'",
    "test:regression": "mocha --timeout 10000 'test/regression/**/*.regression.js'",
    "test:regression:p0": "mocha --timeout 10000 --grep '\\[regression:p0\\]' 'test/regression/**/*.regression.js'",
    "test:regression:p0p1": "mocha --timeout 10000 --grep '\\[regression:p[01]\\]' 'test/regression/**/*.regression.js'",
    "test:perf": "mocha --reporter ./test/reporters/performance-reporter.js --bail --timeout 30000 --exit --require ./test/initialCheck.test.js 'test/smoke/**/*.smoke.js'",
    "test:perf:actions": "mocha --reporter ./test/reporters/performance-reporter.js --timeout 0 --exit --require ./test/initialCheck.test.js 'test/actions/**/*.test.js'",
    "test:perf:e2e": "mocha --reporter ./test/reporters/performance-reporter.js --timeout 0 --exit --require ./test/initialCheck.test.js 'test/e2e/**/*.e2e.js'",
    "test:perf:budget": "mocha --timeout 120000 --exit --require ./test/initialCheck.test.js 'test/perf/**/*.perf.test.js'",
    "perf:gate": "node scripts/perf-gate.js",
    "perf:report": "node scripts/perf-report.js",
    "venue:clear-sentinels": "node scripts/clear-seed-sentinels.js",
    "test:mutate": "npx stryker run",
    "test:mutate:integration": "npx stryker run stryker.phase2.config.mjs",
    "test:mutate:dry-run": "npx stryker run --dryRunOnly",
    "mutate:report": "node scripts/mutation-report.js",
    "test:sdk:attestation": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/attestation.sdk.test.js",
    "test:parity": "mocha --timeout 0 --exit --require ./test/parity/parityBoot.js test/parity/multichain-parity.test.js",
    "test:sdk:bet-expiry": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/betExpiry.sdk.test.js test/sdk/betBackdate.sdk.test.js",
    "test:sdk:bet-latch": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/betLatchAtomicity.sdk.test.js",
    "test:sdk:bet-ws": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/betWebsocket.sdk.test.js",
    "test:sdk:bet-parity": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/betParity.sdk.test.js",
    "test:sdk:multileg": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/multiLegSend.sdk.test.js",
    "test:attest-relay-loop": "mocha --timeout 0 --exit --require ./test/initialCheck.test.js test/sdk/attestationRelayLoopDrill.js"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/mocha-runner": "^9.6.1",
    "chai": "^4.5.0",
    "fast-check": "^4.8.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "fast-uri": "^3.1.4",
    "tmp": "^0.2.7",
    "qs": "^6.15.2",
    "mocha": {
      "diff": "^8.0.4"
    },
    "js-yaml": "^4.3.0",
    "form-data": "^4.0.6",
    "shell-quote": "^1.9.0",
    "serialize-javascript": "^7.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
