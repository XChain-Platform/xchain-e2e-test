.env
# Backups and variants of the env file carry the SAME credentials as .env
# itself (node RPC password, indexer + hub DB passwords), and a bare `.env`
# rule does not cover them. A .env.bak-* sitting in this repo was one
# `git add -A` away from being committed.
.env.*
node_modules/
.DS_Store
perf-results/
# Staged at build time by xchain-node (LIBRARY_BUNDLES) - not part of the repo
/xchain-hub/
/xchain-sdk/

# Coverage output (c8/nyc) - generated, not source
coverage/
.nyc_output/

# Stryker mutation-report build artifacts - generated, embed absolute paths (curated .md reports are kept)
reports/mutation/*.html
reports/mutation/*.json

# seed-contract-state.js resume files. Public facts only (contract index, txids),
# but they are per-run per-chain state, not source.
.seed-*.json

# Hub spend_guard runtime state (data/spend-state/<label>.json), written relative
# to the cwd when a hub is driven from this directory. Per-run state, not source.
data/spend-state/

# Oracle publisher batch buffer, a sibling of the publish queue and written to the
# same cwd-relative default. A drill should redirect the publisher's paths into a
# temp dir (see test/helpers/oracleBatchVenue.js) rather than rely on this rule,
# but the rule keeps an un-redirected run from staging an hour of buffered rounds
# as if it were source. Note data/ is only PARTLY ignored here: some queue files
# in it are deliberately tracked.
data/*.buffer.jsonl
